# Copie para .env.local e preencha. Nunca versionar .env.local.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas (Etapa 2)
MONGODB_URI=
MONGODB_DB=enviai

# Better Auth (Etapa 3). O segredo também criptografa os tokens do Google.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Etapa 3). Redirect URI no Google Cloud:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
